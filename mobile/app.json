{
  "expo": {
    "name": "UniWheels",
    "slug": "uniwheels",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "uniwheels",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "co.edu.unab.uniwheels"
    },
    "android": {
      "package": "co.edu.unab.uniwheels",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020617",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UniWheels necesita tu ubicación para mostrarte en el mapa y calcular puntos de encuentro con conductores o pasajeros cercanos."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniWheels necesita acceso a tus fotos para que elijas una imagen de perfil.",
          "cameraPermission": "UniWheels necesita acceso a tu cámara para tomarte una foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
