#!/usr/bin/env bash
# ==============================================================================
# UniWheels — CLI Maestro de Orquestación y Desarrollo Local
# Plataforma de Movilidad Compartida y Carpooling Universitario UNAB
# ==============================================================================

set -e

# Colores ANSI para terminal
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="${ROOT_DIR}/.uniwheels"
PID_DIR="${RUNTIME_DIR}/pids"
LOG_DIR="${RUNTIME_DIR}/logs"

mkdir -p "${PID_DIR}" "${LOG_DIR}"

# Definición de Servicios Backend y Frontend
SERVICES=(
    "auth-service:8001:services/auth-service:php artisan serve --host=0.0.0.0 --port=8001"
    "vehicle-service:8002:services/vehicle-service:php artisan serve --host=0.0.0.0 --port=8002"
    "route-matching-service:8003:services/route-matching-service:php artisan serve --host=0.0.0.0 --port=8003"
    "trip-service:8004:services/trip-service:php artisan serve --host=0.0.0.0 --port=8004"
    "notification-service:8005:services/notification-service:php artisan serve --host=0.0.0.0 --port=8005"
    "ai-route-service:8006:services/ai-route-service:PYTHONPATH=. .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8006 --reload"
    "frontend-spa:5173:frontend:npm run dev"
)

# Imprimir banner oficial
print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  🚗  UniWheels — Control Maestro del Ecosistema"
    echo "  Universidad Autónoma de Bucaramanga (UNAB)"
    echo -e "${NC}"
}

# Comprobar si un puerto está en escucha
check_port() {
    local port=$1
    if command -v ss >/dev/null 2>&1; then
        ss -tuln | grep -q ":${port} " && return 0 || return 1
    elif command -v nc >/dev/null 2>&1; then
        nc -z 127.0.0.1 "${port}" >/dev/null 2>&1 && return 0 || return 1
    elif command -v lsof >/dev/null 2>&1; then
        lsof -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1 && return 0 || return 1
    else
        (echo > /dev/tcp/127.0.0.1/"${port}") >/dev/null 2>&1 && return 0 || return 1
    fi
}

# Matar procesos en un puerto específico
kill_port() {
    local port=$1
    if command -v fuser >/dev/null 2>&1; then
        fuser -k "${port}/tcp" >/dev/null 2>&1 || true
    elif command -v lsof >/dev/null 2>&1; then
        local pids
        pids=$(lsof -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)
        if [ -n "${pids}" ]; then
            kill -9 ${pids} >/dev/null 2>&1 || true
        fi
    fi
}

# Iniciar contenedor de infraestructura básica si no está activo
start_infrastructure() {
    echo -e "${BLUE}▶ Verificando infraestructura de bases de datos (PostgreSQL 16, PostGIS, Redis, OSRM)...${NC}"
    
    if check_port 5432 && check_port 6379; then
        echo -e "  ${GREEN}✓${NC} PostgreSQL y Redis ya se encuentran en ejecución."
        return 0
    fi

    if command -v podman >/dev/null 2>&1; then
        echo -e "  ${YELLOW}⚡ Levantando contenedores con Podman Compose...${NC}"
        podman compose -f "${ROOT_DIR}/docker/docker-compose.yml" up -d >/dev/null 2>&1 || true
    elif command -v docker >/dev/null 2>&1; then
        echo -e "  ${YELLOW}⚡ Levantando contenedores con Docker Compose...${NC}"
        docker compose -f "${ROOT_DIR}/docker/docker-compose.yml" up -d >/dev/null 2>&1 || true
    else
        echo -e "  ${YELLOW}⚠ Podman/Docker no detectado. Asumiendo servicios locales de PostgreSQL y Redis.${NC}"
    fi

    sleep 2
}

# Iniciar todos los servicios
cmd_start() {
    print_banner
    start_infrastructure
    echo ""
    echo -e "${BLUE}▶ Iniciando los 6 microservicios y el Frontend SPA...${NC}"

    for entry in "${SERVICES[@]}"; do
        IFS=':' read -r name port path cmd <<< "${entry}"
        local pid_file="${PID_DIR}/${name}.pid"
        local log_file="${LOG_DIR}/${name}.log"

        if check_port "${port}"; then
            echo -e "  ${GREEN}●${NC} ${name} ya está activo en el puerto ${BOLD}:${port}${NC}"
            continue
        fi

        echo -ne "  ${CYAN}⚡${NC} Arrancando ${BOLD}${name}${NC} (: ${port} )... "
        
        # Ejecutar en subshell en background
        (
            cd "${ROOT_DIR}/${path}"
            eval "${cmd}" > "${log_file}" 2>&1
        ) &
        local pid=$!
        echo "${pid}" > "${pid_file}"

        # Esperar confirmación de puerto (hasta 10 segundos)
        local count=0
        local started=false
        while [ $count -lt 20 ]; do
            if check_port "${port}"; then
                started=true
                break
            fi
            sleep 0.5
            count=$((count + 1))
        done

        if [ "${started}" = true ]; then
            echo -e "${GREEN}✓ Activo (PID: ${pid})${NC}"
        else
            echo -e "${YELLOW}Iniciando en segundo plano (PID: ${pid})${NC}"
        fi
    done

    echo ""
    cmd_status
}

# Detener todos los servicios
cmd_stop() {
    print_banner
    echo -e "${YELLOW}▶ Deteniendo microservicios y frontend de UniWheels...${NC}"

    for entry in "${SERVICES[@]}"; do
        IFS=':' read -r name port path cmd <<< "${entry}"
        local pid_file="${PID_DIR}/${name}.pid"

        if [ -f "${pid_file}" ]; then
            local pid
            pid=$(cat "${pid_file}")
            if kill -0 "${pid}" >/dev/null 2>&1; then
                kill "${pid}" >/dev/null 2>&1 || true
            fi
            rm -f "${pid_file}"
        fi

        # Matar cualquier proceso restante en el puerto
        kill_port "${port}"
        echo -e "  ${RED}■${NC} ${name} detenido (: ${port} )"
    done

    echo ""
    echo -e "${GREEN}✓ Todos los servicios han sido detenidos limpiamente.${NC}"
}

# Estado de todos los servicios
cmd_status() {
    print_banner
    echo -e "${BOLD}TABLA DE ESTADO Y SALUD DEL ECOSISTEMA:${NC}"
    echo "---------------------------------------------------------------------------------"
    printf "%-25s %-8s %-12s %-32s\n" "SERVICIO" "PUERTO" "ESTADO" "URL / ENDPOINT"
    echo "---------------------------------------------------------------------------------"

    # Bases de Datos e Infraestructura
    if check_port 5432; then
        printf "%-25s %-8s ${GREEN}%-12s${NC} %-32s\n" "PostgreSQL 16 (PostGIS)" "5432" "ACTIVO" "pgsql://uniwheels_user:5432"
    else
        printf "%-25s %-8s ${RED}%-12s${NC} %-32s\n" "PostgreSQL 16 (PostGIS)" "5432" "INACTIVO" "Requiere docker-compose up"
    fi

    if check_port 6379; then
        printf "%-25s %-8s ${GREEN}%-12s${NC} %-32s\n" "Redis 7 Cache" "6379" "ACTIVO" "redis://127.0.0.1:6379"
    else
        printf "%-25s %-8s ${RED}%-12s${NC} %-32s\n" "Redis 7 Cache" "6379" "INACTIVO" "Requiere docker-compose up"
    fi

    if check_port 5000; then
        printf "%-25s %-8s ${GREEN}%-12s${NC} %-32s\n" "OSRM Routing Engine" "5000" "ACTIVO" "http://localhost:5000"
    else
        printf "%-25s %-8s ${YELLOW}%-12s${NC} %-32s\n" "OSRM Routing Engine" "5000" "OPCIONAL" "Modo simulador / local"
    fi

    # Microservicios de Aplicación
    for entry in "${SERVICES[@]}"; do
        IFS=':' read -r name port path cmd <<< "${entry}"
        local url="http://localhost:${port}"
        if [ "${name}" = "ai-route-service" ]; then
            url="http://localhost:${port}/docs"
        elif [ "${name}" = "frontend-spa" ]; then
            url="http://localhost:${port}"
        else
            url="http://localhost:${port}/api/v1"
        fi

        if check_port "${port}"; then
            printf "%-25s %-8s ${GREEN}%-12s${NC} %-32s\n" "${name}" "${port}" "EN LÍNEA" "${url}"
        else
            printf "%-25s %-8s ${RED}%-12s${NC} %-32s\n" "${name}" "${port}" "DETENIDO" "${url}"
        fi
    done
    echo "---------------------------------------------------------------------------------"
    echo -e "Para ver registros en tiempo real: ${CYAN}./uniwheels logs [servicio]${NC}"
    echo ""
}

# Ver logs
cmd_logs() {
    local target=$1
    if [ -z "${target}" ]; then
        echo -e "${BLUE}Mostrando registros combinados de todos los servicios (Ctrl+C para salir):${NC}"
        tail -f "${LOG_DIR}"/*.log
    else
        # Buscar coincidencia
        local match=""
        for entry in "${SERVICES[@]}"; do
            IFS=':' read -r name port path cmd <<< "${entry}"
            if [[ "${name}" == *"${target}"* ]]; then
                match="${name}"
                break
            fi
        done

        if [ -n "${match}" ] && [ -f "${LOG_DIR}/${match}.log" ]; then
            echo -e "${BLUE}Mostrando registros de ${BOLD}${match}${NC} (Ctrl+C para salir):"
            tail -f "${LOG_DIR}/${match}.log"
        else
            echo -e "${RED}No se encontró archivo de log para '${target}'. Servicios disponibles:${NC}"
            ls -1 "${LOG_DIR}" | sed 's/.log//'
        fi
    fi
}

# Ejecutar pruebas en todo el ecosistema
cmd_test() {
    print_banner
    echo -e "${BLUE}▶ Ejecutando suite completa de pruebas automatizadas...${NC}"
    echo ""

    echo -e "${CYAN}1. Pruebas Pest en auth-service (:8001)...${NC}"
    (cd "${ROOT_DIR}/services/auth-service" && ./vendor/bin/pest)

    echo -e "\n${CYAN}2. Pruebas Pest en vehicle-service (:8002)...${NC}"
    (cd "${ROOT_DIR}/services/vehicle-service" && ./vendor/bin/pest)

    echo -e "\n${CYAN}3. Pruebas PHPUnit en trip-service (:8004)...${NC}"
    (cd "${ROOT_DIR}/services/trip-service" && php artisan test)

    echo -e "\n${CYAN}4. Pruebas Pytest en ai-route-service (:8006)...${NC}"
    (cd "${ROOT_DIR}/services/ai-route-service" && PYTHONPATH=. .venv/bin/pytest tests/)

    echo -e "\n${CYAN}5. Verificación de Compilación Frontend SPA (:5173)...${NC}"
    (cd "${ROOT_DIR}/frontend" && npm run build)

    echo ""
    echo -e "${GREEN}✓ Toda la suite de pruebas se ha completado exitosamente.${NC}"
}

# Ejecutar migraciones en todos los servicios Laravel
cmd_migrate() {
    print_banner
    echo -e "${BLUE}▶ Ejecutando migraciones en todas las bases de datos...${NC}"
    
    local laravel_services=("auth-service" "vehicle-service" "route-matching-service" "trip-service" "notification-service")
    for s in "${laravel_services[@]}"; do
        echo -e "  ${CYAN}⚡ Migrando ${s}...${NC}"
        (cd "${ROOT_DIR}/services/${s}" && php artisan migrate --force)
    done

    echo -e "${GREEN}✓ Migraciones completadas en los 5 microservicios.${NC}"
}

# Ayuda y comandos
cmd_help() {
    print_banner
    echo -e "${BOLD}USO:${NC} ./uniwheels [COMANDO]"
    echo ""
    echo -e "${BOLD}COMANDOS DISPONIBLES:${NC}"
    echo -e "  ${GREEN}start${NC} | ${GREEN}dev${NC}       Inicia la infraestructura, los 6 microservicios y el frontend."
    echo -e "  ${RED}stop${NC}  | ${RED}down${NC}      Detiene todos los microservicios y libera los puertos."
    echo -e "  ${YELLOW}restart${NC}           Reinicia completamente todos los servicios."
    echo -e "  ${CYAN}status${NC} | ${CYAN}ps${NC}       Muestra la tabla de salud y URLs de cada servicio."
    echo -e "  ${BLUE}logs${NC} [servicio]  Muestra los logs en tiempo real (ej: ./uniwheels logs auth)."
    echo -e "  ${CYAN}test${NC}              Ejecuta todas las pruebas unitarias y de integración."
    echo -e "  ${CYAN}migrate${NC}           Ejecuta las migraciones en las 5 bases de datos Laravel."
    echo -e "  ${CYAN}help${NC}              Muestra este menú de ayuda."
    echo ""
    echo -e "${BOLD}EJEMPLOS:${NC}"
    echo "  ./uniwheels start"
    echo "  ./uniwheels status"
    echo "  ./uniwheels logs ai"
    echo "  ./uniwheels stop"
    echo ""
}

# Router de comandos
case "$1" in
    start|dev|up)
        cmd_start
        ;;
    stop|down)
        cmd_stop
        ;;
    restart)
        cmd_stop
        sleep 1
        cmd_start
        ;;
    status|ps)
        cmd_status
        ;;
    logs)
        cmd_logs "$2"
        ;;
    test)
        cmd_test
        ;;
    migrate)
        cmd_migrate
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${RED}Comando desconocido: '$1'${NC}"
        cmd_help
        exit 1
        ;;
esac
